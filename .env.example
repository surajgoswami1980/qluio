# Copy to .env.local and fill in.
#
# Public JSON POST endpoint that receives contact-form inquiries
# (e.g. a Formspree form URL: https://formspree.io/f/xxxxxxx).
# Leave empty to keep the form in "delivery not configured" mode.
#
# This value is exposed to the browser. NEVER put SMTP passwords,
# private API keys, or other secrets here.
NEXT_PUBLIC_CONTACT_ENDPOINT=
